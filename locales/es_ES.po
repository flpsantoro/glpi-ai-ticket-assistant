msgid "Write a draft in the editor first."
msgstr "Escriba primero un borrador en el editor."

#: src/Assistant.php:557
msgid "You cannot update this ticket."
msgstr "No puede modificar este ticket."

#: src/Assistant.php:570
msgid "This category is not available for the entity of the ticket."
msgstr "Esta categoría no está disponible para la entidad del ticket."

#: src/Assistant.php:573
msgid "This category cannot be used with this ticket type."
msgstr "Esta categoría no se puede usar con este tipo de ticket."

#: src/Assistant.php:582
msgid "Nothing to apply."
msgstr "Nada que aplicar."

#: src/Assistant.php:595
msgid "Classification applied to the ticket."
msgstr "Clasificación aplicada al ticket."

#: src/Assistant.php:596
msgid "GLPI refused the update of the ticket."
msgstr "GLPI rechazó la actualización del ticket."

#: src/Assistant.php:609
msgid "A knowledge base article can be written once the ticket has a solution."
msgstr "Se puede redactar un artículo de la base de conocimiento cuando el ticket tenga una solución."

#: src/Assistant.php:66
msgid "Ticket not found."
msgstr "Ticket no encontrado."

#: src/Assistant.php:662
msgid "You cannot create knowledge base articles."
msgstr "No puede crear artículos de la base de conocimiento."

#: src/Assistant.php:667
msgid "The article needs a title and a content."
msgstr "El artículo necesita un título y un contenido."

#: src/Assistant.php:678
msgid "GLPI refused the creation of the article."
msgstr "GLPI rechazó la creación del artículo."

#: src/Assistant.php:69
msgid "You cannot see this ticket."
msgstr "No tiene acceso a este ticket."

#: src/Assistant.php:694
msgid "Draft article created: review it and choose its audience to publish it."
msgstr "Borrador de artículo creado: revíselo y elija su público para publicarlo."

#: src/Assistant.php:719
msgid "This ticket was processed a moment ago. Wait %d s to generate again."
msgstr "Este ticket se procesó hace un momento. Espere %d s para generar de nuevo."

#: src/Assistant.php:72
msgid "The AI assistant is not enabled."
msgstr "El asistente de IA no está habilitado."

#: src/Assistant.php:730
msgid "You reached the limit of %d uses of the assistant per hour. Try again later."
msgstr "Alcanzó el límite de %d usos del asistente por hora. Inténtelo más tarde."

#: src/Assistant.php:739
msgid "The daily budget of the AI assistant is exhausted. Try again tomorrow or contact the administrator."
msgstr "Se agotó el presupuesto diario del asistente de IA. Inténtelo mañana o contacte con el administrador."

