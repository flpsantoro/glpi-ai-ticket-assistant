msgstr "Máximo de imagens"

#: src/ConfigForm.php:226
msgid "Maximum size sent (MB)"
msgstr "Tamanho máximo enviado (MB)"

#: src/ConfigForm.php:227
msgid "Longest side (pixels)"
msgstr "Maior lado (pixels)"

#: src/ConfigForm.php:228
