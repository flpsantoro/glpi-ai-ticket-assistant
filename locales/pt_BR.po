msgstr "Nenhum"

#: src/ConfigForm.php:220
msgid "Include the assets linked to the ticket"
msgstr "Incluir os ativos vinculados ao chamado"

#: src/ConfigForm.php:221
msgid "Include the solution templates of the entity as style references"
msgstr "Incluir os modelos de solução da entidade como referência de estilo"

#: src/ConfigForm.php:223
