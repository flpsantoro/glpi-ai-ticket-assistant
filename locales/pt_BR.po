#: src/TicketHooks.php:242
msgid "Write a draft in the editor first."
msgstr "Escreva um rascunho no editor primeiro."

#: src/Assistant.php:558
msgid "You cannot update this ticket."
msgstr "Você não pode alterar este chamado."

#: src/Assistant.php:571
msgid "This category is not available for the entity of the ticket."
msgstr "Esta categoria não está disponível para a entidade do chamado."

#: src/Assistant.php:574
msgid "This category cannot be used with this ticket type."
msgstr "Esta categoria não pode ser usada com este tipo de chamado."

#: src/Assistant.php:583
msgid "Nothing to apply."
msgstr "Nada a aplicar."

#: src/Assistant.php:596
msgid "Classification applied to the ticket."
msgstr "Classificação aplicada ao chamado."

#: src/Assistant.php:597
msgid "GLPI refused the update of the ticket."
msgstr "O GLPI recusou a atualização do chamado."

#: src/Assistant.php:610
msgid "A knowledge base article can be written once the ticket has a solution."
msgstr "O artigo da base de conhecimento pode ser escrito quando o chamado tiver uma solução."

#: src/Assistant.php:663
msgid "You cannot create knowledge base articles."
msgstr "Você não pode criar artigos na base de conhecimento."

#: src/Assistant.php:668
msgid "The article needs a title and a content."
msgstr "O artigo precisa de título e conteúdo."

#: src/Assistant.php:67
msgid "Ticket not found."
msgstr "Chamado não encontrado."

#: src/Assistant.php:679
msgid "GLPI refused the creation of the article."
msgstr "O GLPI recusou a criação do artigo."

#: src/Assistant.php:695
msgid "Draft article created: review it and choose its audience to publish it."
msgstr "Rascunho de artigo criado: revise-o e escolha o público para publicá-lo."

#: src/Assistant.php:70
msgid "You cannot see this ticket."
msgstr "Você não tem acesso a este chamado."

#: src/Assistant.php:720
msgid "This ticket was processed a moment ago. Wait %d s to generate again."
msgstr "Este chamado foi processado há pouco. Aguarde %d s para gerar novamente."

#: src/Assistant.php:73
msgid "The AI assistant is not enabled."
msgstr "O assistente de IA não está habilitado."

#: src/Assistant.php:731
msgid "You reached the limit of %d uses of the assistant per hour. Try again later."
msgstr "Você atingiu o limite de %d usos do assistente por hora. Tente mais tarde."

#: src/Assistant.php:740
msgid "The daily budget of the AI assistant is exhausted. Try again tomorrow or contact the administrator."
msgstr "O orçamento diário do assistente de IA acabou. Tente amanhã ou avise o administrador."

#: src/Assistant.php:822
msgid "Service desk team"
msgstr "Equipe de atendimento"

