{
    "name": "flpsantoro/glpi-ai-ticket-assistant",
    "description": "AI assistant for GLPI tickets: analysis with images and documents, reply drafts, text rewriting, classification learned from solved tickets and knowledge base articles. GLPI 10, 11 and 12.",
    "type": "glpi-plugin",
    "license": "GPL-2.0-or-later",
    "keywords": ["glpi", "glpi-plugin", "itsm", "helpdesk", "ai", "llm", "openai", "azure-openai", "anthropic", "ollama"],
    "homepage": "https://github.com/flpsantoro/glpi-ai-ticket-assistant",
    "authors": [
        {
            "name": "Felipe Santoro Alcantara",
            "homepage": "https://github.com/flpsantoro"
        }
    ],
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload-dev": {
        "psr-4": {
            "GlpiPlugin\\Ticketassistant\\": "src/",
            "GlpiPlugin\\Ticketassistant\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "platform": {
            "php": "7.4.33"
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "lint": "find . -path ./vendor -prune -o -name '*.php' -print0 | xargs -0 -n1 php -l"
    }
}
